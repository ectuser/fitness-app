# Copy to .env.local (the only local configuration file; it is gitignored).
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness
POSTGRES_DB=fitness
POSTGRES_PORT=5432

# Used by apps/api
DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness
PORT=3001

# Public origin of the web app (the page origin, also where Better Auth lives).
APP_ORIGIN=http://localhost:3000
# Signs and encrypts auth data. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-replace-with-openssl-rand-base64-32

# Two-environment policy mode: local | prod
APP_ENV=local

# Auth backend base URL (host-only cookie scope expected)
AUTH_APP_URL=http://localhost:3000

# Session secret used for signing/encryption
AUTH_SESSION_SECRET=replace-with-a-strong-random-secret

# Telegram OIDC client configuration
AUTH_TELEGRAM_CLIENT_ID=replace-with-telegram-client-id
AUTH_TELEGRAM_CLIENT_SECRET=replace-with-telegram-client-secret
AUTH_TELEGRAM_ISSUER=https://oauth.telegram.org

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

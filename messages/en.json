      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} exercise",
        "countPlural=other": "{count} exercises"
      }
    }
  ],
  "rapid_sage_badger": [
    {
      "declarations": [
        "input weekday",
        "input day",
        "input month",
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{weekday} {day} {month}: {count} workout",
        "countPlural=other": "{weekday} {day} {month}: {count} workouts"
      }
    }
  ],

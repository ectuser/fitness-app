{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file=../../.env.local\"",
    "start": "node --env-file=../../.env.local dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env.local ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@fitness/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@rspack/core": "2.2.9",
    "@types/express": "5.0.6",
    "@types/node": "24.13.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.9",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:",
    "webpack-node-externals": "3.0.0"
  }
}
